pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'vicentearce/prestabanco-frontend'
    }
    
    stages {
        stage('Verify Tools') {
            steps {
                script {
                    bat 'docker --version'
                    bat 'npm --version'
                    bat 'node --version'
                }
            }
        }
        
        stage('Build Frontend') {
            steps {
                script {
                    try {
                        checkout scmGit(
                            branches: [[name: '*/main']], 
                            extensions: [], 
                            userRemoteConfigs: [[url: 'https://github.com/VicenteArce/Tingeso-Entrega-1']]
                        )
                        
                        dir('Frontend') {
                            bat 'npm cache clean --force'
                            bat 'npm install'
                            bat 'npm run build'
                        }
                    } catch (Exception e) {
                        error "Failed to build frontend: ${e.message}"
                    }
                }
            }
        }
        
        stage('Build and Push Docker Image') {
            steps {
                dir('Frontend') {
                    script {
                        try {
                            withDockerRegistry(credentialsId: 'docker-credentials') {
                                // Construir y publicar solo la versión latest
                                bat "docker build -t ${DOCKER_IMAGE}:latest ."
                                bat "docker push ${DOCKER_IMAGE}:latest"
                            }
                        } catch (Exception e) {
                            error "Failed to build or push Docker image: ${e.message}"
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            // Limpieza
            script {
                bat "docker rmi ${DOCKER_IMAGE}:latest || true"
                cleanWs()
            }
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed! Check the logs for details."
        }
    }
}